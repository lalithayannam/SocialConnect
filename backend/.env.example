PORT=5002
MONGODB_URI=mongodb://127.0.0.1:27017/socialconnect
JWT_SECRET=replace_this_with_a_long_random_secret_before_running

# Razorpay test keys (never expose the secret in frontend code)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Email greeting sent after payment verification (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
EMAIL_FROM=SocialConnect <your_email@gmail.com>

# Fundraiser verification controls
FUNDRAISER_ADMIN_KEY=replace_with_a_long_random_admin_key
# Set true ONLY for local demos; leave false/omitted for manual verification
FUNDRAISER_AUTO_VERIFY=false
